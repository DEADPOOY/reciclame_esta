# Conexión principal: copia la URI de Supabase > Connect > Session pooler.
# Descarga el CA de Supabase como supabase-ca.crt en la raíz del proyecto.
# Codifica caracteres especiales de la contraseña en la URI.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=supabase-ca.crt
PORT=3000

# Solo se usan durante la importación única desde tu MySQL anterior.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=reciclame_esta
MYSQL_PASSWORD=CAMBIA_ESTA_CONTRASENA
MYSQL_DATABASE=reciclame_esta

# Supabase (para iniciar sesión con GitHub)
# 1. Crea un proyecto en https://supabase.com/dashboard
# 2. Copia el Project URL y la publishable/anon key de Project Settings > API
# 3. Pega aquí los valores reales para el login social
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU_PUBLISHABLE_KEY
