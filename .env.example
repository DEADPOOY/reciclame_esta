# ahi va asta arriba del todo
# Conexión principal: copia la URI de Supabase > Connect > Session pooler.
# El certificado supabase/supabase-ca.crt ya viene incluido en el repositorio.
# Codifica caracteres especiales de la contraseña en la URI.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=supabase/supabase-ca.crt
PORT=3000

# [OBSOLETO] Solo se usan durante la importación única desde tu MySQL anterior.
# La aplicación ya no se conecta a MySQL; puedes ignorar este bloque.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=reciclame_esta
MYSQL_PASSWORD=CAMBIA_ESTA_CONTRASENA
MYSQL_DATABASE=reciclame_esta

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU_PUBLISHABLE_KEY
